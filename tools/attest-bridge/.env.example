# Copia este archivo a .env (NO se sube a git) y completa los valores.

# --- Red (Testnet) ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
EXPLORER_NETWORK=testnet

# Contrato de Attest v2 en Testnet (contracts/stellar/bindings/src/contracts.json del repo de Attest)
ATTEST_CONTRACT_ID=CA2QET2KOUGAECEVYQEQT3SLDDZRUMAQHI7MMDTFVJY62WTHUTERAUCD

# Se llena después de correr `npm run register-schema`
ATTEST_SCHEMA_UID=

# Cuenta de la PLATFORMA (la que firma todo). Secreto: empieza con S...
PLATFORM_SECRET=

# Clave compartida con el adaptador C# (inventa una larga y aleatoria)
BRIDGE_API_KEY=

# Opcional
# PORT=4010
# HOST=127.0.0.1

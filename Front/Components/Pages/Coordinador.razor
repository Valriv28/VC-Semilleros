@page "/Coordinador"

<PageTitle>Portal del Coordinador - VC-Semilleros</PageTitle>

<div class="container-fluid p-0">
    <div class="row g-0" style="min-height: 80vh;">
        <!-- Sidebar Navigation Lateral -->
        <div class="col-md-3 col-lg-2 bg-dark border-end border-secondary p-3">
            <div class="mb-4 text-white fw-bold fs-6">
                <span class="text-primary me-2">🎯</span> Módulo Coordinador
            </div>
            
            <div class="nav flex-column nav-pills gap-1">
                <button class="nav-link text-start text-white @(seccionActiva == "armar" ? "active bg-primary" : "")" 
                        @onclick='() => CambiarSeccion("armar")'>
                    🎨 Armar Credencial
                </button>
                <button class="nav-link text-start text-white @(seccionActiva == "criterios" ? "active bg-primary" : "")" 
                        @onclick='() => CambiarSeccion("criterios")'>
                    ⚙️ Definir Criterios
                </button>
                <button class="nav-link text-start text-white @(seccionActiva == "elegibilidad" ? "active bg-primary" : "")" 
                        @onclick='() => CambiarSeccion("elegibilidad")'>
                    ⚡ Elegibilidad y Emisión
                </button>
                <button class="nav-link text-start text-white @(seccionActiva == "revocacion" ? "active bg-primary" : "")" 
                        @onclick='() => CambiarSeccion("revocacion")'>
                    🚫 Revocar Credenciales
                </button>
            </div>
        </div>

        <!-- Área Principal de Contenido -->
        <div class="col-md-9 col-lg-10 p-4">
            @if (seccionActiva == "armar")
            {
                <div class="card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="fw-bold text-white m-0">Armar y Diseñar Credencial</h4>
                            <p class="text-secondary small mb-0">Configura la estructura, títulos y metadatos del certificado del semillero.</p>
                        </div>
                        <button class="btn btn-primary-custom btn-sm" @onclick="GuardarPlantilla">
                            💾 Guardar Plantilla
                        </button>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label text-secondary small">Nombre del Certificado / Credencial</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="credencialConfig.Titulo" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-secondary small">Subtítulo / Tipo de Reconocimiento</label>
                                <input type="text" class="form-control bg-dark text-white border-secondary" @bind="credencialConfig.Subtitulo" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-secondary small">Descripción de la Actividad</label>
                                <textarea class="form-control bg-dark text-white border-secondary" rows="3" @bind="credencialConfig.Descripcion"></textarea>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label text-secondary small">Horas Certificadas</label>
                                    <input type="number" class="form-control bg-dark text-white border-secondary" @bind="credencialConfig.Horas" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-secondary small">Vigencia (Meses)</label>
                                    <input type="number" class="form-control bg-dark text-white border-secondary" @bind="credencialConfig.VigenciaMeses" />
                                </div>
                            </div>
                        </div>

                        <!-- Vista Previa de la Credencial -->
                        <div class="col-lg-6">
                            <label class="form-label text-secondary small d-block mb-2">Vista Previa de la Credencial</label>
                            <div class="card border-0 rounded-4 p-4 text-white shadow-lg" 
                                 style="background: linear-gradient(135deg, #059669 0%, #0284C7 50%, #1D4ED8 100%);">
                                <div class="d-flex justify-content-between align-items-start mb-4">
                                    <div>
                                        <small class="text-white-50 text-uppercase fw-semibold tracking-wider">CREDENCIAL DIGITAL VERIFICABLE</small>
                                        <div class="fw-mono small">CRED-2026-PREVIEW</div>
                                    </div>
                                    <div class="bg-white bg-opacity-20 px-3 py-1 rounded-3 fw-bold">
                                        VC
                                    </div>
                                </div>

                                <h3 class="fw-bold mb-1">@credencialConfig.Titulo</h3>
                                <p class="text-white-50 mb-3">@credencialConfig.Subtitulo</p>
                                <p class="small text-white-50 mb-4">@credencialConfig.Descripcion</p>

                                <div class="row g-2 pt-2 border-top border-white border-opacity-25">
                                    <div class="col-6">
                                        <small class="text-white-50 text-uppercase fw-semibold d-block">HORAS</small>
                                        <span class="fw-bold">@credencialConfig.Horas Horas</span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-white-50 text-uppercase fw-semibold d-block">INSTITUCIÓN</small>
                                        <span class="fw-bold">VC-Semilleros</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (seccionActiva == "criterios")
            {
                <div class="card-custom p-4" style="max-width: 750px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="fw-bold text-white m-0">Definir Criterios de Evaluación</h4>
                            <p class="text-secondary small mb-0">Establece los parámetros mínimos que calcularán la elegibilidad automática.</p>
                        </div>
                        <button class="btn btn-primary-custom btn-sm" @onclick="GuardarCriterios">
                            💾 Guardar Criterios
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Asistencia Mínima Requerida (%)</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="criterios.AsistenciaMinima" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">Entregables y Ponencias Requeridas (%)</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="criterios.EntregablesRequeridos" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small">Tiempo de Permanencia Mínimo (Meses)</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="criterios.PermanenciaMeses" />
                    </div>

                    <div class="p-3 bg-dark border border-secondary rounded text-secondary small">
                        💡 Los estudiantes que cumplan o superen estos valores serán marcados como <strong>Elegibles</strong> para autorización.
                    </div>
                </div>
            }
            else if (seccionActiva == "elegibilidad")
            {
                <div class="card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="fw-bold text-white m-0">Evaluación de Elegibilidad y Emisión</h4>
                            <p class="text-secondary small mb-0">Evalúa candidatos y autoriza la emisión oficial de credenciales digitales.</p>
                        </div>
                        <button class="btn btn-primary-custom btn-sm" @onclick="EjecutarEvaluacion">
                            ⚡ Recalcular Elegibilidad
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr class="text-secondary small">
                                    <th>PARTICIPANTE</th>
                                    <th>ASISTENCIA</th>
                                    <th>ENTREGABLES</th>
                                    <th>ESTADO ELEGIBILIDAD</th>
                                    <th>AUTORIZACIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in candidatos)
                                {
                                    <tr>
                                        <td class="fw-bold">@c.Nombre</td>
                                        <td>@c.Asistencia%</td>
                                        <td>@c.Entregables%</td>
                                        <td>
                                            @if (c.EsElegible)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">
                                                    ● Elegible
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1">
                                                    ✕ No Elegible
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (c.Emitida)
                                            {
                                                <span class="text-success small fw-bold">✓ Credencial Emitida</span>
                                            }
                                            else if (c.EsElegible)
                                            {
                                                <button class="btn btn-primary-custom btn-sm py-1" @onclick="() => AutorizarEmision(c)">
                                                    Autorizar Emisión
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary btn-sm py-1" disabled>
                                                    No Autorizable
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (seccionActiva == "revocacion")
            {
                <div class="card-custom p-4">
                    <h4 class="fw-bold text-white mb-2">Revocación de Credenciales</h4>
                    <p class="text-secondary small mb-4">Invalida credenciales emitidas previamente por faltas, anulación de proyecto o error.</p>

                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr class="text-secondary small">
                                    <th>CÓDIGO</th>
                                    <th>TITULAR</th>
                                    <th>FECHA EMISIÓN</th>
                                    <th>ESTADO</th>
                                    <th>ACCIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cred in credencialesEmitidas)
                                {
                                    <tr>
                                        <td class="fw-mono text-secondary">@cred.Codigo</td>
                                        <td class="fw-bold">@cred.Titular</td>
                                        <td>@cred.FechaEmision</td>
                                        <td>
                                            @if (cred.Revocada)
                                            {
                                                <span class="badge bg-danger">Revocada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Activa / Válida</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!cred.Revocada)
                                            {
                                                <button class="btn btn-outline-danger btn-sm py-0" @onclick="() => RevocarCredencial(cred)">
                                                    Revocar Credencial
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-secondary small">Sin acción</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string seccionActiva = "armar";

    // Modelo de Configuración de Credencial
    private class CredencialConfig
    {
        public string Titulo { get; set; } = "Participación en Semillero de Investigación";
        public string Subtitulo { get; set; } = "Certificación de Productos & Ponencias";
        public string Descripcion { get; set; } = "Otorgado por la contribución activa y desarrollo de proyectos de I+D durante el periodo académico.";
        public int Horas { get; set; } = 120;
        public int VigenciaMeses { get; set; } = 24;
    }

    private CredencialConfig credencialConfig = new();

    // Modelo de Criterios
    private class CriteriosEvaluacion
    {
        public int AsistenciaMinima { get; set; } = 80;
        public int EntregablesRequeridos { get; set; } = 100;
        public int PermanenciaMeses { get; set; } = 6;
    }

    private CriteriosEvaluacion criterios = new();

    // Modelo Candidatos
    private class Candidato
    {
        public string Nombre { get; set; } = string.Empty;
        public int Asistencia { get; set; }
        public int Entregables { get; set; }
        public bool EsElegible { get; set; }
        public bool Emitida { get; set; }
    }

    private List<Candidato> candidatos = new()
    {
        new Candidato { Nombre = "Ana María Torres Vega", Asistencia = 85, Entregables = 100, EsElegible = true, Emitida = false },
        new Candidato { Nombre = "Juan Pablo Gómez", Asistencia = 60, Entregables = 50, EsElegible = false, Emitida = false },
        new Candidato { Nombre = "Laura Sofia Restrepo", Asistencia = 92, Entregables = 100, EsElegible = true, Emitida = true }
    };

    // Modelo Credenciales Emitidas
    private class CredencialEmitida
    {
        public string Codigo { get; set; } = string.Empty;
        public string Titular { get; set; } = string.Empty;
        public string FechaEmision { get; set; } = string.Empty;
        public bool Revocada { get; set; }
    }

    private List<CredencialEmitida> credencialesEmitidas = new()
    {
        new CredencialEmitida { Codigo = "CRED-2024-0841", Titular = "Ana María Torres Vega", FechaEmision = "2024-06-15", Revocada = false },
        new CredencialEmitida { Codigo = "CRED-2024-0842", Titular = "Laura Sofia Restrepo", FechaEmision = "2024-08-20", Revocada = false }
    };

    private void CambiarSeccion(string seccion)
    {
        seccionActiva = seccion;
    }

    private void GuardarPlantilla() { }
    private void GuardarCriterios() { }

    private void EjecutarEvaluacion()
    {
        foreach (var c in candidatos)
        {
            c.EsElegible = c.Asistencia >= criterios.AsistenciaMinima && c.Entregables >= criterios.EntregablesRequeridos;
        }
    }

    private void AutorizarEmision(Candidato c)
    {
        c.Emitida = true;
        credencialesEmitidas.Add(new CredencialEmitida
        {
            Codigo = $"CRED-2026-0{credencialesEmitidas.Count + 1}",
            Titular = c.Nombre,
            FechaEmision = DateTime.Now.ToString("yyyy-MM-dd"),
            Revocada = false
        });
    }

    private void RevocarCredencial(CredencialEmitida cred)
    {
        cred.Revocada = true;
    }
}
@page "/Coordinador"
@using System.Text.Json
@inject Front.Servicios.SesionUsuario Sesion
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject Front.Servicios.SemillerosService SemillerosService
@inject Front.Servicios.PeriodosService PeriodosService
@inject Front.Servicios.EvaluacionesService EvaluacionesService
@inject Front.Servicios.CredencialesService CredencialesService
@inject Front.Servicios.AdministracionService Administracion

<PageTitle>Portal del Coordinador - VC-Semilleros</PageTitle>

@if (accesoPermitido)
{
    <div class="container-fluid p-0">
        <div class="row g-0" style="min-height:80vh;">
            <aside class="col-md-3 col-lg-2 bg-dark border-end border-secondary p-3">
                <div class="mb-4 text-white fw-bold">🎯 Módulo Coordinador</div>
                <div class="nav flex-column nav-pills gap-1">
                    <button class="nav-link text-start text-white @(seccionActiva == "criterios" ? "active bg-primary" : "")" @onclick='() => CambiarSeccion("criterios")'>⚙️ Criterios</button>
                    <button class="nav-link text-start text-white @(seccionActiva == "evaluaciones" ? "active bg-primary" : "")" @onclick='() => CambiarSeccion("evaluaciones")'>⚡ Elegibilidad</button>
                    <button class="nav-link text-start text-white @(seccionActiva == "emision" ? "active bg-primary" : "")" @onclick='() => CambiarSeccion("emision")'>🎓 Emitir credencial</button>
                    <button class="nav-link text-start text-white @(seccionActiva == "blockchain" ? "active bg-primary" : "")" @onclick='() => CambiarSeccion("blockchain")'>🔗 Transacciones blockchain</button>
                    <button class="nav-link text-start text-white @(seccionActiva == "revocacion" ? "active bg-primary" : "")" @onclick='() => CambiarSeccion("revocacion")'>🚫 Revocar credencial</button>
                </div>
            </aside>
            <main class="col-md-9 col-lg-10 p-4">
                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="alert @(esError ? "alert-danger" : "alert-info")" role="alert">@mensaje</div>
                }

                <section class="card-custom p-4 mb-4">
                    <h4 class="text-white fw-bold mb-3">Seleccionar período</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary">Semillero</label>
                            <select class="form-select bg-dark text-white border-secondary" value="@semilleroId" @onchange="CambiarSemilleroAsync" disabled="@cargando">
                                <option value="0">Selecciona un semillero</option>
                                @foreach (var item in semilleros)
                                {
                                    <option value="@item.Id">@item.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary">Período</label>
                            <select class="form-select bg-dark text-white border-secondary" value="@periodoId" @onchange="CambiarPeriodoAsync" disabled="@(cargando || semilleroId <= 0)">
                                <option value="0">Selecciona un período</option>
                                @foreach (var item in periodos)
                                {
                                    <option value="@item.Id">@item.Nombre (@item.FechaInicio.ToString("yyyy-MM-dd") — @item.FechaFin.ToString("yyyy-MM-dd"))</option>
                                }
                            </select>
                        </div>
                    </div>
                </section>

                @if (seccionActiva == "criterios")
                {
                    <section class="card-custom p-4">
                        <h4 class="text-white fw-bold">Configurar criterios del período</h4>
                        <p class="text-secondary">La configuración se guarda en PostgreSQL y cada actualización genera una nueva versión.</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label text-secondary">Asistencia mínima (%)</label>
                                <input type="number" min="0" max="100" class="form-control bg-dark text-white border-secondary" @bind="minAsistencia" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-secondary">Entregables requeridos (%)</label>
                                <input type="number" min="0" max="100" class="form-control bg-dark text-white border-secondary" @bind="entregables" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-secondary">Permanencia (meses)</label>
                                <input type="number" min="0" class="form-control bg-dark text-white border-secondary" @bind="permanencia" />
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-primary-custom" disabled="@(cargando || periodoId <= 0)" @onclick="GuardarCriteriosAsync">Guardar criterios</button>
                            <button class="btn btn-outline-light" disabled="@(cargando || periodoId <= 0)" @onclick="CargarCriteriosAsync">Recargar criterios</button>
                        </div>
                        @if (criterioVersion > 0)
                        {
                            <p class="text-secondary small mt-3 mb-0">Versión @criterioVersion · Definido por usuario @definidoPor · Actualizado: @fechaCriterio</p>
                        }
                    </section>
                }
                else if (seccionActiva == "evaluaciones" || seccionActiva == "emision")
                {
                    <section class="card-custom p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <h4 class="text-white fw-bold mb-1">@(seccionActiva == "emision" ? "Emitir credenciales" : "Evaluaciones del período")</h4>
                                <p class="text-secondary small mb-0">La emisión solo se habilita después de que el coordinador declare elegible una evaluación que cumple los criterios.</p>
                            </div>
                            <button class="btn btn-outline-light" disabled="@(cargando || periodoId <= 0)" @onclick="CargarEvaluacionesAsync">Actualizar</button>
                        </div>
                        @if (evaluaciones.Count == 0)
                        {
                            <p class="text-secondary">No hay evaluaciones registradas para este período o aún no has seleccionado uno.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover align-middle">
                                    <thead><tr><th>Evaluación</th><th>Participante</th><th>Asistencia</th><th>Resultado</th><th>Elegibilidad</th><th>Acciones</th></tr></thead>
                                    <tbody>
                                        @foreach (var e in evaluaciones)
                                        {
                                            <tr>
                                                <td>@e.Id</td>
                                                <td>@e.ParticipanteId</td>
                                                <td>@e.PctAsistencia%</td>
                                                <td><span class="badge @(e.Cumple ? "bg-success" : "bg-danger")">@(e.Cumple ? "Cumple" : "No cumple")</span></td>
                                                <td>@(e.ElegibleDeclaradoPor.HasValue ? $"Declarada por {e.ElegibleDeclaradoPor}" : "Pendiente")</td>
                                                <td>
                                                    @if (!e.ElegibleDeclaradoPor.HasValue && e.Cumple)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success mb-1" disabled="@cargando" @onclick="() => DeclararElegibilidadAsync(e)">Declarar</button>
                                                    }
                                                    @if (e.ElegibleDeclaradoPor.HasValue)
                                                    {
                                                        var emitida = credencialesEmitidas.FirstOrDefault(c => c.EvaluacionId == e.Id);
                                                        @if (emitida is not null)
                                                        {
                                                            <span class="badge bg-success">Emitida</span>
                                                            <div class="small text-secondary">@emitida.Codigo</div>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-primary" disabled="@cargando" @onclick="() => EmitirAsync(e)">Emitir credencial</button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (emisiones.Count > 0)
                        {
                            <h5 class="text-white mt-4">Emisiones realizadas en esta sesión</h5>
                            <ul class="text-secondary">
                                @foreach (var item in emisiones) { <li>@item</li> }
                            </ul>
                        }
                    </section>
                }
                else if (seccionActiva == "blockchain")
                {
                    <section class="card-custom p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <h4 class="text-white fw-bold mb-1">Transacciones de blockchain</h4>
                                <p class="text-secondary small mb-0">Registros de anclaje guardados en la base de datos. Solo los registros con hash de transacción tienen enlace al explorador.</p>
                            </div>
                            <button class="btn btn-outline-light" disabled="@cargando" @onclick="CargarTransaccionesAsync">Actualizar</button>
                        </div>
                        @if (transacciones.Count == 0)
                        {
                            <p class="text-secondary">No hay transacciones registradas todavía. Las solicitudes pendientes o fallidas también aparecen si quedaron guardadas en la tabla de anclajes.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover align-middle">
                                    <thead><tr><th>Fecha</th><th>Credencial</th><th>Estado</th><th>Hash de evidencia</th><th>Transacción</th><th>Attestation UID</th></tr></thead>
                                    <tbody>
                                        @foreach (var t in transacciones)
                                        {
                                            <tr @key="t.Id">
                                                <td>@t.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                <td>@t.CredencialCodigo</td>
                                                <td><span class="badge @(t.Estado == "ANCLADO" ? "bg-success" : t.Estado == "FALLIDO" ? "bg-danger" : "bg-warning text-dark")">@t.Estado</span></td>
                                                <td><code class="text-white text-break">@t.EvidenciaHash</code></td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(t.TxHash))
                                                    {
                                                        <a href="@($"https://stellar.expert/explorer/testnet/tx/{Uri.EscapeDataString(t.TxHash)}")" target="_blank" rel="noopener noreferrer" class="text-info">Ver transacción ↗</a>
                                                        <div class="small text-secondary text-break">@t.TxHash</div>
                                                    }
                                                    else { <span class="text-secondary">Sin hash de transacción</span> }
                                                </td>
                                                <td class="text-break">@(string.IsNullOrWhiteSpace(t.AttestationUid) ? "—" : t.AttestationUid)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }
                else if (seccionActiva == "revocacion")
                {
                    <section class="card-custom p-4" style="max-width:760px;">
                        <h4 class="text-white fw-bold">Revocar credencial</h4>
                        <p class="text-secondary">La revocación se registra en el backend. Ingresa el código exacto de una credencial emitida.</p>
                        <div class="mb-3">
                            <label class="form-label text-secondary">Código de credencial</label>
                            <input class="form-control bg-dark text-white border-secondary" @bind="codigoRevocacion" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary">Motivo</label>
                            <textarea class="form-control bg-dark text-white border-secondary" @bind="motivoRevocacion" maxlength="500"></textarea>
                        </div>
                        <button class="btn btn-outline-danger" disabled="@cargando" @onclick="RevocarAsync">Revocar credencial</button>
                    </section>
                }
            </main>
        </div>
    </div>
}

@code {
    private bool accesoPermitido;
    private const string RolPermitido = "COORDINADOR";
    private string seccionActiva = "criterios";
    private string mensaje = "";
    private bool esError;
    private bool cargando;
    private int semilleroId;
    private int periodoId;
    private List<SemilleroVista> semilleros = new();
    private List<PeriodoVista> periodos = new();
    private List<EvaluacionVista> evaluaciones = new();
    private List<TransaccionBlockchainVista> transacciones = new();
    private List<CredencialEmitidaVista> credencialesEmitidas = new();
    private List<string> emisiones = new();
    private decimal minAsistencia = 80;
    private decimal entregables = 100;
    private int permanencia = 6;
    private int criterioVersion;
    private int definidoPor;
    private string fechaCriterio = "";
    private string codigoRevocacion = "";
    private string motivoRevocacion = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!Sesion.EstaAutenticado) { Navigation.NavigateTo("/login", replace: true); return; }
        var rol = Sesion.Rol?.Trim().ToUpperInvariant();
        if (rol != RolPermitido)
        {
            Navigation.NavigateTo(rol switch { "ESTUDIANTE" => "/Titular", "DOCENTE" => "/Docente", "ADMINISTRADOR" => "/Admin", _ => "/login" }, replace: true);
            return;
        }
        accesoPermitido = true;
        await CargarSemillerosAsync();
        StateHasChanged();
    }

    private async Task CambiarSeccion(string seccion)
    {
        seccionActiva = seccion;
        if (seccion is "evaluaciones" or "emision")
        {
            if (periodoId > 0) await CargarEvaluacionesAsync();
        }
        else if (seccion == "blockchain")
        {
            await CargarTransaccionesAsync();
        }
    }

    private async Task CargarTransaccionesAsync()
    {
        cargando = true;
        try
        {
            var json = await Administracion.ListarTransaccionesBlockchainAsync<JsonElement>();
            transacciones = LeerLista<TransaccionBlockchainVista>(json);
            Mostrar(transacciones.Count == 0 ? "No hay registros de anclaje todavía." : $"Se consultaron {transacciones.Count} registros de anclaje.", false);
        }
        catch (Exception ex)
        {
            Mostrar($"No se pudieron consultar las transacciones: {ex.Message}", true);
        }
        finally { cargando = false; }
    }

    private async Task CargarSemillerosAsync()
    {
        cargando = true;
        try
        {
            var json = await SemillerosService.ListarAsync<JsonElement>();
            semilleros = LeerLista<SemilleroVista>(json);
            Mostrar(semilleros.Count == 0 ? "No hay semilleros disponibles." : "", false);
        }
        catch (Exception ex) { Mostrar($"No se pudieron cargar los semilleros: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task CambiarSemilleroAsync(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out semilleroId);
        periodoId = 0; periodos.Clear(); evaluaciones.Clear();
        if (semilleroId <= 0) return;
        cargando = true;
        try
        {
            var json = await SemillerosService.ListarPeriodosAsync<JsonElement>(semilleroId);
            periodos = LeerLista<PeriodoVista>(json);
            Mostrar(periodos.Count == 0 ? "El semillero no tiene períodos registrados." : "", false);
        }
        catch (Exception ex) { Mostrar($"No se pudieron cargar los períodos: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task CambiarPeriodoAsync(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out periodoId);
        evaluaciones.Clear(); criterioVersion = 0;
        if (periodoId <= 0) return;
        await CargarCriteriosAsync();
        await CargarEvaluacionesAsync();
    }

    private async Task CargarCriteriosAsync()
    {
        if (periodoId <= 0) return;
        cargando = true;
        try
        {
            var json = await PeriodosService.ObtenerCriterioVigenteAsync<JsonElement>(periodoId);
            if (json.ValueKind is JsonValueKind.Undefined or JsonValueKind.Null)
            {
                Mostrar("Este período aún no tiene criterios configurados.", false);
                return;
            }
            var c = LeerObjeto<CriterioVista>(json);
            if (c is not null)
            {
                minAsistencia = c.MinAsistenciaPct; entregables = c.EntregablesRequeridosPct;
                permanencia = c.PermanenciaMeses; criterioVersion = c.CriterioVersion;
                definidoPor = c.DefinidoPor; fechaCriterio = c.FechaActualizacion?.ToString("yyyy-MM-dd HH:mm") ?? "no disponible";
                Mostrar("Criterios cargados desde el backend.", false);
            }
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("404")) { Mostrar("Este período aún no tiene criterios configurados.", false); }
        catch (Exception ex) { Mostrar($"No se pudieron cargar los criterios: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task GuardarCriteriosAsync()
    {
        if (periodoId <= 0) { Mostrar("Selecciona un período.", true); return; }
        if (minAsistencia is < 0 or > 100 || entregables is < 0 or > 100 || permanencia < 0)
        { Mostrar("Los porcentajes deben estar entre 0 y 100 y la permanencia no puede ser negativa.", true); return; }
        cargando = true;
        try
        {
            var json = await PeriodosService.GuardarCriterioVigenteAsync<object, JsonElement>(periodoId, new {
                minAsistenciaPct = minAsistencia, entregablesRequeridosPct = entregables, permanenciaMeses = permanencia
            });
            var c = json is { ValueKind: not JsonValueKind.Undefined } ? LeerObjeto<CriterioVista>(json) : null;
            if (c is not null) { criterioVersion = c.CriterioVersion; definidoPor = c.DefinidoPor; }
            Mostrar("Criterios guardados en el backend.", false);
            await CargarCriteriosAsync();
        }
        catch (Exception ex) { Mostrar($"No se pudieron guardar los criterios: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task CargarEvaluacionesAsync()
    {
        if (periodoId <= 0) return;
        cargando = true;
        try
        {
            var json = await PeriodosService.ListarEvaluacionesAsync<JsonElement>(periodoId);
            evaluaciones = LeerLista<EvaluacionVista>(json);
            try
            {
                var emitidasJson = await Administracion.ListarCredencialesEmitidasAsync<JsonElement>(periodoId);
                credencialesEmitidas = LeerLista<CredencialEmitidaVista>(emitidasJson);
            }
            catch
            {
                // La lista de evaluaciones sigue disponible aunque falle la consulta complementaria.
                credencialesEmitidas = new();
            }
            Mostrar(evaluaciones.Count == 0 ? "No hay evaluaciones registradas para este período." : "Evaluaciones actualizadas.", false);
        }
        catch (Exception ex) { Mostrar($"No se pudieron cargar las evaluaciones: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task DeclararElegibilidadAsync(EvaluacionVista e)
    {
        if (Sesion.Id is not int id) { Mostrar("No se encontró el identificador de la sesión.", true); return; }
        cargando = true;
        try
        {
            await EvaluacionesService.DeclararElegibilidadAsync<object, JsonElement>(e.Id, new { declaradoPor = id });
            Mostrar($"Elegibilidad declarada para la evaluación {e.Id}.", false);
            await CargarEvaluacionesAsync();
        }
        catch (Exception ex) { Mostrar($"No se pudo declarar la elegibilidad: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task EmitirAsync(EvaluacionVista e)
    {
        cargando = true;
        try
        {
            var respuesta = await EvaluacionesService.EmitirAsync<JsonElement>(e.Id);
            if (respuesta is { ValueKind: not JsonValueKind.Undefined })
            {
                var codigo = respuesta.TryGetProperty("codigo", out var c) ? c.GetString() : null;
                emisiones.Insert(0, string.IsNullOrWhiteSpace(codigo) ? $"Evaluación {e.Id}: respuesta recibida." : codigo);
            }
            Mostrar($"Solicitud de emisión procesada para la evaluación {e.Id}.", false);
            await CargarEvaluacionesAsync();
        }
        catch (Exception ex) { Mostrar($"No se pudo emitir la credencial: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task RevocarAsync()
    {
        if (Sesion.Id is not int id) { Mostrar("No se encontró el identificador de la sesión.", true); return; }
        if (string.IsNullOrWhiteSpace(codigoRevocacion) || string.IsNullOrWhiteSpace(motivoRevocacion))
        { Mostrar("Escribe el código y el motivo de revocación.", true); return; }
        cargando = true;
        try
        {
            await CredencialesService.RevocarAsync<object, JsonElement>(codigoRevocacion.Trim(),
                new { revocadaPor = id, motivo = motivoRevocacion.Trim() });
            Mostrar("La credencial fue revocada en el backend.", false);
            codigoRevocacion = ""; motivoRevocacion = "";
        }
        catch (Exception ex) { Mostrar($"No se pudo revocar la credencial: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private void Mostrar(string texto, bool error) { mensaje = texto; esError = error; }

    private static List<T> LeerLista<T>(JsonElement? respuesta)
    {
        if (respuesta is null || respuesta.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined) return new();
        var e = respuesta.Value;
        if (e.ValueKind == JsonValueKind.Object && e.TryGetProperty("datos", out var datos)) e = datos;
        if (e.ValueKind != JsonValueKind.Array) return new();
        return JsonSerializer.Deserialize<List<T>>(e.GetRawText(), Opciones) ?? new();
    }

    private static T? LeerObjeto<T>(JsonElement e) => e.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined
        ? default : JsonSerializer.Deserialize<T>(e.GetRawText(), Opciones);

    private static readonly JsonSerializerOptions Opciones = new() { PropertyNameCaseInsensitive = true };

    private sealed class SemilleroVista { public int Id { get; set; } public string Nombre { get; set; } = ""; }
    private sealed class PeriodoVista { public int Id { get; set; } public string Nombre { get; set; } = ""; public DateOnly FechaInicio { get; set; } public DateOnly FechaFin { get; set; } }
    private sealed class CriterioVista { public int PeriodoId { get; set; } public int CriterioVersion { get; set; } public decimal MinAsistenciaPct { get; set; } public decimal EntregablesRequeridosPct { get; set; } public int PermanenciaMeses { get; set; } public int DefinidoPor { get; set; } public DateTime? FechaActualizacion { get; set; } }
    private sealed class EvaluacionVista { public int Id { get; set; } public int ParticipanteId { get; set; } public decimal PctAsistencia { get; set; } public bool Cumple { get; set; } public int? ElegibleDeclaradoPor { get; set; } }
    private sealed class CredencialEmitidaVista
    {
        public int EvaluacionId { get; set; }
        public string Codigo { get; set; } = "";
        public string Estado { get; set; } = "";
    }
    private sealed class TransaccionBlockchainVista
    {
        public int Id { get; set; }
        public string CredencialCodigo { get; set; } = "";
        public string EvidenciaHash { get; set; } = "";
        public string? TxHash { get; set; }
        public string Estado { get; set; } = "";
        public string? AttestationUid { get; set; }
        public DateTime FechaSolicitud { get; set; }
        public DateTime? FechaExpiracion { get; set; }
    }
}

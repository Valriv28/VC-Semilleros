        </div>
        <div class="col-md-4 border-end border-secondary">
            <h2 class="fw-bold text-white mb-0">Certificados</h2>
            <small class="text-secondary">Participación y Productos</small>
        </div>
        <div class="col-md-4">
            <h2 class="fw-bold text-white mb-0">Verificable</h2>
            <small class="text-secondary">Validez Institucional</small>
        </div>

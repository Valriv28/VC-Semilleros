@page "/"

<PageTitle>Inicio - Semillero de Investigación</PageTitle>

<!-- Banner Principal / Hero Section -->
<div class="text-center my-5 py-5">
    <span class="badge-green mb-3 d-inline-block">Semillero de Investigación & Desarrollo</span>
    <h1 class="display-3 fw-bold text-white mb-3">
        Credenciales Digitales para <span style="color: #1B59F8;">Semilleros</span>
    </h1>
    <p class="text-secondary mx-auto lead" style="max-width: 680px;">
        Plataforma para la emisión, consulta y certificación verificable de la participación en proyectos, ponencias y productos académicos del semillero.
    </p>
</div>


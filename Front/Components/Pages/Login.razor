@page "/login"
@using System.ComponentModel.DataAnnotations
@using Front.Servicios
@inject AutenticacionService Autenticacion
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - VC Semilleros</PageTitle>

<div class="login-page-wrapper">
    <div class="login-card-dark text-center">

        <button type="button"
                class="btn-close-custom"
                @onclick="VolverAlInicio"
                title="Regresar al Inicio">
            ✕
        </button>

        <div class="mb-2 fs-1">🔒</div>
        <h3 class="fw-bold text-white mb-1">Iniciar Sesión</h3>
        <p class="text-secondary small mb-4">
            Acceso al Portal de VC-Semilleros
        </p>

        <EditForm Model="@modelo" OnValidSubmit="Ingresar">
            <DataAnnotationsValidator />

            <div class="text-start mb-3">
                <label class="form-label">Correo Institucional</label>
                <InputText class="form-control"
                           @bind-Value="modelo.Correo"
                           placeholder="usuario@institucion.edu.co"
                           autocomplete="username" />
                <ValidationMessage For="@(() => modelo.Correo)"
                                   class="text-danger small" />
            </div>

            <div class="text-start mb-3">
                <label class="form-label">Contraseña</label>
                <InputText type="password"
                           class="form-control"
                           @bind-Value="modelo.Contrasena"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                <ValidationMessage For="@(() => modelo.Contrasena)"
                                   class="text-danger small" />
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert @(esError ? "alert-danger" : "alert-success")
                            py-1 px-2 small mb-3"
                     role="alert">
                    @mensaje
                </div>
            }

            <button type="submit"
                    class="btn btn-primary-custom w-100 py-2 mb-3"
                    disabled="@cargando">
                @(cargando ? "Validando..." : "Ingresar")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private ModeloLogin modelo = new();
    private string? mensaje;
    private bool esError;
    private bool cargando;

    private async Task Ingresar()
    {
        if (cargando)
            return;

        cargando = true;
        mensaje = null;
        esError = false;

        try
        {
            var resultado = await Autenticacion.IngresarAsync(
                modelo.Correo,
                modelo.Contrasena);

            if (!resultado.Exito)
            {
                esError = true;
                mensaje = resultado.Mensaje;
                return;
            }

            // El token y el rol ya están en SesionUsuario.
            // El destino se ajustará a las rutas y permisos reales.
            
            var destino = Sesion.Rol?.Trim().ToUpperInvariant() switch
           {
            "ESTUDIANTE" => "/Titular",
            "DOCENTE" => "/Docente",
             "COORDINADOR" => "/Coordinador",
            "ADMINISTRADOR" => "/Admin",
             _ => null
        };

if (destino is null)
{
    Sesion.CerrarSesion();
    esError = true;
    mensaje = "Tu cuenta no tiene un rol válido para ingresar.";
    return;
}

Navigation.NavigateTo(destino);

        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverAlInicio()
    {
        Navigation.NavigateTo("/");
    }

    public sealed class ModeloLogin
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Ingrese un correo válido.")]
        public string Correo { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Contrasena { get; set; } = string.Empty;
    }
}

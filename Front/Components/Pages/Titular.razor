@page "/Titular"
@using System.Text.Json
@using Microsoft.JSInterop
@inject Front.Servicios.SesionUsuario Sesion
@inject Front.Servicios.CredencialesService CredencialesService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Portal del Titular - VC-Semilleros</PageTitle>

@if (accesoPermitido)
{
    <div class="container-fluid p-0">
        <div class="border-bottom border-secondary mb-4">
            <ul class="nav nav-tabs border-0 gap-2">
                <li class="nav-item"><button class="nav-link @(pestanaActiva == "mis-credenciales" ? "active bg-dark text-white" : "text-secondary")" @onclick='() => CambiarPestana("mis-credenciales")'>Mis credenciales</button></li>
                <li class="nav-item"><button class="nav-link @(pestanaActiva == "ver-credencial" ? "active bg-dark text-white" : "text-secondary")" @onclick='() => CambiarPestana("ver-credencial")'>Ver credencial</button></li>
            </ul>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(esError ? "alert-danger" : "alert-info")">@mensaje</div>
        }
        @if (cargando)
        {
            <p class="text-secondary">Consultando tus credenciales…</p>
        }
        else if (pestanaActiva == "mis-credenciales")
        {
            <h3 class="fw-bold text-white mb-2">Mis credenciales registradas</h3>
            <p class="text-secondary">Información recuperada de tu cuenta autenticada.</p>
            @if (credenciales.Count == 0)
            {
                <div class="card-custom p-4"><p class="text-secondary mb-0">No hay credenciales emitidas para tu cuenta.</p></div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var cred in credenciales)
                    {
                        <div class="col-12 col-xl-8">
                            <div class="card-custom p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <h5 class="fw-bold text-white mb-1">@cred.Tipo</h5>
                                    <div class="text-secondary small">Código: @cred.Codigo</div>
                                    <div class="text-secondary small">Emisión: @cred.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    <span class="badge @(cred.Estado.Equals("VIGENTE", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">@cred.Estado</span>
                                </div>
                                <button class="btn btn-outline-light btn-sm" @onclick="() => VerCredencialAsync(cred)">Ver detalle</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <h2 class="fw-bold text-white mb-2">Detalle de credencial</h2>
            @if (credencialSeleccionada is null)
            {
                <p class="text-secondary">Selecciona una credencial en “Mis credenciales” para consultar su estado y contenido verificable.</p>
                <button class="btn btn-outline-light" @onclick='() => CambiarPestana("mis-credenciales")'>Volver a mis credenciales</button>
            }
            else
            {
                <div class="card-custom p-4 mb-3" style="max-width:760px;">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div><h4 class="text-white fw-bold">@credencialSeleccionada.Tipo</h4><div class="text-secondary">Código: @credencialSeleccionada.Codigo</div></div>
                        <span class="badge @(credencialSeleccionada.Estado.Equals("VIGENTE", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary")">@credencialSeleccionada.Estado</span>
                    </div>
                    <div class="mt-3"><small class="text-secondary d-block">Hash de la credencial</small><code class="text-white text-break">@credencialSeleccionada.VcHash</code></div>
                    <div class="mt-3"><small class="text-secondary d-block">Fecha de emisión</small><span class="text-white">@credencialSeleccionada.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button class="btn btn-primary-custom" disabled="@cargando" @onclick="ConsultarVcAsync">Consultar credencial verificable (VC)</button>
                        <button class="btn btn-outline-success" disabled="@cargando" @onclick="CompartirCredencialAsync">Compartir / copiar credencial</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(textoParaCompartir))
                    {
                        <div class="mt-3">
                            <label class="form-label text-secondary">Contenido para compartir</label>
                            <textarea class="form-control bg-dark text-white border-secondary" rows="5" readonly @bind="textoParaCompartir"></textarea>
                            <p class="small text-secondary mt-1">Si el navegador no permitió copiar automáticamente, selecciona y copia este contenido para enviarlo a quien deba verificar la credencial.</p>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(vcContenido))
                {
                    <div class="card-custom p-4" style="max-width:900px;">
                        <h5 class="text-white">Contenido VC devuelto por la API</h5>
                        <pre class="text-white small text-break" style="white-space:pre-wrap;">@vcContenido</pre>
                    </div>
                }
            }
        }
    </div>
}

@code {
    private bool accesoPermitido;
    private bool cargando;
    private bool esError;
    private string mensaje = "";
    private string pestanaActiva = "mis-credenciales";
    private string vcContenido = "";
    private string textoParaCompartir = "";
    private List<CredencialVista> credenciales = new();
    private CredencialVista? credencialSeleccionada;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!Sesion.EstaAutenticado) { Navigation.NavigateTo("/login", replace: true); return; }
        var rol = Sesion.Rol?.Trim().ToUpperInvariant();
        if (rol != "ESTUDIANTE")
        {
            Navigation.NavigateTo(rol switch { "DOCENTE" => "/Docente", "COORDINADOR" => "/Coordinador", "ADMINISTRADOR" => "/Admin", _ => "/login" }, replace: true);
            return;
        }
        accesoPermitido = true;
        await CargarCredencialesAsync();
        StateHasChanged();
    }

    private void CambiarPestana(string pestana) { pestanaActiva = pestana; mensaje = ""; }

    private async Task CargarCredencialesAsync()
    {
        if (Sesion.Id is not int titularId) { Mostrar("No se pudo identificar la cuenta autenticada.", true); return; }
        cargando = true;
        try
        {
            var json = await CredencialesService.ListarAsync<JsonElement>(titularId);
            credenciales = LeerLista<CredencialVista>(json);
            Mostrar(credenciales.Count == 0 ? "No hay credenciales asociadas a tu cuenta." : $"{credenciales.Count} credencial(es) cargada(s).", false);
        }
        catch (Exception ex) { Mostrar($"No se pudieron consultar tus credenciales: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task VerCredencialAsync(CredencialVista cred)
    {
        credencialSeleccionada = cred;
        vcContenido = "";
        textoParaCompartir = "";
        pestanaActiva = "ver-credencial";
        cargando = true;
        try
        {
            var estado = await CredencialesService.ObtenerEstadoAsync<JsonElement>(cred.Codigo);
            if (estado is { ValueKind: JsonValueKind.Object } && estado.TryGetProperty("estado", out var valor))
                cred.Estado = valor.ToString();
            Mostrar("Detalle y estado consultados desde la API.", false);
        }
        catch (Exception ex) { Mostrar($"No se pudo consultar el estado: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task ConsultarVcAsync()
    {
        if (credencialSeleccionada is null) return;
        cargando = true;
        try
        {
            var json = await CredencialesService.ObtenerVcAsync<JsonElement>(credencialSeleccionada.Codigo);
            vcContenido = json.ValueKind != JsonValueKind.Undefined ? json.GetRawText() : "La API no devolvió contenido.";
            Mostrar("Credencial verificable recuperada.", false);
        }
        catch (Exception ex) { Mostrar($"No se pudo obtener la VC: {ex.Message}", true); }
        finally { cargando = false; }
    }

    private async Task CompartirCredencialAsync()
    {
        if (credencialSeleccionada is null) return;
        cargando = true;
        textoParaCompartir = "";
        try
        {
            var json = await CredencialesService.ObtenerVcAsync<JsonElement>(credencialSeleccionada.Codigo);
            var contenido = "";
            if (json.ValueKind == JsonValueKind.Object && json.TryGetProperty("vc", out var vcValor))
                contenido = vcValor.ValueKind == JsonValueKind.String ? vcValor.GetString() ?? "" : vcValor.GetRawText();
            else if (json.ValueKind != JsonValueKind.Undefined)
                contenido = json.GetRawText();
            if (string.IsNullOrWhiteSpace(contenido))
            {
                Mostrar("La API no devolvió el contenido de la credencial para compartir.", true);
                return;
            }

            textoParaCompartir = contenido;
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", contenido);
                Mostrar("Credencial copiada. Ahora puedes pegarla y enviarla a quien deba verificarla.", false);
            }
            catch
            {
                Mostrar("No se pudo copiar automáticamente. El contenido está disponible abajo para copiarlo manualmente.", false);
            }
        }
        catch (Exception ex)
        {
            Mostrar($"No se pudo preparar la credencial para compartir: {ex.Message}", true);
        }
        finally { cargando = false; }
    }

    private void Mostrar(string texto, bool error) { mensaje = texto; esError = error; }
    private static readonly JsonSerializerOptions Opciones = new() { PropertyNameCaseInsensitive = true };
    private static List<T> LeerLista<T>(JsonElement? json)
    {
        if (json is null || json.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined) return new();
        var e = json.Value;
        if (e.ValueKind == JsonValueKind.Object && e.TryGetProperty("datos", out var datos)) e = datos;
        return e.ValueKind == JsonValueKind.Array ? JsonSerializer.Deserialize<List<T>>(e.GetRawText(), Opciones) ?? new() : new();
    }

    private sealed class CredencialVista
    {
        public string Codigo { get; set; } = "";
        public int TitularId { get; set; }
        public string Tipo { get; set; } = "";
        public string Estado { get; set; } = "";
        public string VcHash { get; set; } = "";
        public DateTime FechaEmision { get; set; }
    }
}

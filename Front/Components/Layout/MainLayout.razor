@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <header class="navbar navbar-dark px-4 border-bottom border-secondary d-flex justify-content-between align-items-center">
        <a class="navbar-brand d-flex align-items-center fw-bold text-white" href="">
            <span class="text-primary me-2">●</span> VC-Semilleros
        </a>
        <div class="d-flex align-items-center gap-3">
            <span class="badge-green">Portal Semillero</span>
            <button class="btn btn-primary-custom btn-sm" @onclick="MostrarModalLogin">
                Iniciar Sesión
            </button>
        </div>
    </header>

    <main class="container my-5">
        @Body
    </main>
</div>

<!-- Modal de Iniciar Sesión -->
@if (mostrarLogin)
{
    <div class="modal-backdrop-custom d-flex justify-content-center align-items-center">
        <div class="card-custom text-center p-4 modal-login position-relative">
            <button class="btn-close-custom" @onclick="CerrarModalLogin">✕</button>

            <div class="mb-3 fs-1">🔒</div>
            <h3 class="fw-bold text-white mb-2">Iniciar Sesión</h3>
            <p class="text-secondary small mb-4">
                Acceso al Portal de VC-Semilleros
            </p>

            <form @onsubmit="ProcesarLogin">
                <div class="text-start mb-3">
                    <label class="form-label text-secondary small">Correo Institucional</label>
                    <input type="email" class="form-control bg-dark text-white border-secondary" placeholder="usuario@institucion.edu.co" required />
                </div>

                <div class="text-start mb-4">
                    <label class="form-label text-secondary small">Contraseña</label>
                    <input type="password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    Ingresar
                </button>
            </form>
        </div>
    </div>
}

@code {
    private bool mostrarLogin = false;

    private void MostrarModalLogin()
    {
        mostrarLogin = true;
    }

    private void CerrarModalLogin()
    {
        mostrarLogin = false;
    }

    private void ProcesarLogin()
    {
        mostrarLogin = false;
        // Redirige al catálogo de pantallas/dashboard al iniciar sesión
        Navigation.NavigateTo("/catalogo");
    }
}
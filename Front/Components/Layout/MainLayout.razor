@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <header class="navbar navbar-dark px-4 border-bottom border-secondary d-flex justify-content-between align-items-center">
        <a class="navbar-brand d-flex align-items-center fw-bold text-white" href="">
            <span class="text-primary me-2">●</span> VC-Semilleros
        </a>
        <div class="d-flex align-items-center gap-3">
            <span class="badge-green">Portal Semillero</span>
            <!-- Botón que redirige a la vista Login.razor -->
            <button class="btn btn-primary-custom btn-sm" @onclick="IrALogin">
                Iniciar Sesión
            </button>
        </div>
    </header>

    <main class="container my-5">
        @Body
    </main>
</div>

@code {
    private void IrALogin()
    {
        Navigation.NavigateTo("/login");
    }
}